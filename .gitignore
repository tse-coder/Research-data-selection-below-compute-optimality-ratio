# Track ONLY the delivered package, runner, packaging files, and README.

# Ignore everything by default
*

# Re-include directories so git can descend (contents still ignored unless negated)
!*/

# Track the deliverable at the repo root
!/pyproject.toml
!/requirements.txt
!/README.md
!/Makefile
!src/
!src/**/
!src/*.py
!src/**/*.py

# Python artifacts
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Local artifact dirs produced by the package (structure kept via .gitkeep)
artifacts/**
results/**
!artifacts/**/
!artifacts/**/.gitkeep
!results/**/
!results/**/.gitkeep
